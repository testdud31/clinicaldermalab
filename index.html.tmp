      <!-- Quick 3-Way Decision Matrix Cards -->
      <div class="decision-matrix-grid">
        <div class="decision-matrix-card card-acne">
          <span class="matrix-card-tag">Acne, Rosacea &amp; Redness</span>
          <h3 class="matrix-card-title">EltaMD UV Clear (SPF 46) <span>9.9/10</span></h3>
          <p class="matrix-card-desc">
            <strong>Pick This If:</strong> You have blemish-prone, rosacea, or reactive skin and need soothing 5% Niacinamide with non-comedogenic 9.0% transparent zinc oxide that will not clog pores.
          </p>
          <a href="/uv-clear-sunscreen-review.html" class="matrix-card-link">Read Full Lab Review &rarr;</a>
        </div>

        <div class="decision-matrix-card card-scalp">
          <span class="matrix-card-tag">Bald Heads, Scalp &amp; Sports</span>
          <h3 class="matrix-card-title">The Bald Brothers Gel (SPF 50) <span>9.8/10</span></h3>
          <p class="matrix-card-desc">
            <strong>Pick This If:</strong> You shave your head, suffer from forehead or crown glare, sweat heavily during workouts, or hate when sunscreens run into your eyes or leave a white chalky film.
          </p>
          <a href="/the-bald-brothers-spf-50-invisible-sunscreen-gel-review.html" class="matrix-card-link">Read Full Lab Review &rarr;</a>
        </div>

        <div class="decision-matrix-card card-barrier">
          <span class="matrix-card-tag">Dry, Flaking &amp; Barrier Repair</span>
          <h3 class="matrix-card-title">La Roche-Posay Toleriane UV (SPF 30) <span>9.7/10</span></h3>
          <p class="matrix-card-desc">
            <strong>Pick This If:</strong> Your skin is peeling, dehydrated, or sensitized from prescription retinoids and you want a single comforting step with bio-identical Ceramide-3 and prebiotic hydration.
          </p>
          <a href="/la-roche-posay-toleriane-double-repair-review.html" class="matrix-card-link">Read Full Lab Review &rarr;</a>
        </div>
      </div>

