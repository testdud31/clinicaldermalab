          </thead>
          <tbody>
            <tr>
              <td>
                <div class="compare-product-flex">
                  <img src="https://www.clinicaldermalab.io/images/og-clinicaldermalab-cover.jpg" alt="EltaMD UV Clear Face Sunscreen with Zinc Oxide SPF 46 bottle" class="compare-product-img" />
                  <div class="compare-product-info">
                    <span class="compare-badge-pill pill-eltamd">#1 For Acne &amp; Rosacea</span>
                    <h4>EltaMD UV Clear Broad-Spectrum SPF 46</h4>
                    <div class="compare-rating-line">★★★★★ 4.8 / 5 <span>(46,850+ reviews)</span></div>
                    <a href="/uv-clear-sunscreen-review.html" class="table-cta-link">Read Lab Review &rarr;</a>
                  </div>
                </div>
              </td>
              <td>
                <span class="table-tag tag-filter">9.0% Transparent Zinc Oxide</span>
                <span class="table-tag tag-filter">7.5% Octinoxate</span>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">Broad-Spectrum UVA/UVB Physical-Dominant Hybrid</div>
              </td>
              <td>
