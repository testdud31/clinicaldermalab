  <!-- External Clinical Architecture Stylesheets -->
  <link rel="stylesheet" href="/skin-conditions.css" />
  <link rel="stylesheet" href="/clinical-framework.css" />
  <link rel="stylesheet" href="/seo-ymyl-components.css" />

  <style>
    :root {
      --primary: #0e3b43;
      --primary-dark: #08242a;
      --accent: #2a7f62;
      --accent-soft: #e8f5f0;
      --bg-main: #fcfbf9;
      --surface: #ffffff;
      --border: #e6e2db;
      --text: #1d2528;
      --text-muted: #536469;
      --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font-stack);
      line-height: 1.68;
      color: var(--text);
      background-color: var(--bg-main);
      -webkit-font-smoothing: antialiased;
    }
    .container { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 20px; }

    /* Top Trust Bar */
    .top-bar {
      background: var(--primary-dark);
      color: #b7d1d6;
      font-size: 0.8rem;
      padding: 6px 0;
      text-align: center;
      letter-spacing: 0.3px;
    }

    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 0;
      flex-wrap: wrap;
      gap: 16px;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      font-size: 1.25rem;
      color: var(--primary);
      text-decoration: none;
    }
    .badge-certified {
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid rgba(42, 127, 98, 0.25);
      text-transform: uppercase;
    }
    nav ul {
      display: flex;
      list-style: none;
      gap: 18px;
      align-items: center;
      flex-wrap: wrap;
    }
    nav a {
      color: var(--text);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.9rem;
      transition: color 0.15s ease;
    }
    nav a:hover { color: var(--accent); }
    .nav-pill-active {
      background: #eef7f4;
      color: var(--accent) !important;
      padding: 5px 12px;
      border-radius: 6px;
      font-weight: 600;
      border: 1px solid rgba(42, 127, 98, 0.25);
    }

    /* Homepage Hero */
    .hero-section {
      padding: 48px 0 36px;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }
    .hero-eyebrow {
      display: inline-block;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-weight: 700;
      color: var(--accent);
      background: #eef7f4;
      padding: 4px 12px;
      border-radius: 20px;
      margin-bottom: 16px;
      border: 1px solid rgba(42, 127, 98, 0.2);
    }
    .hero-section h1 {
      font-size: 2.6rem;
      color: var(--primary);
      line-height: 1.22;
      max-width: 860px;
      margin: 0 auto 16px;
    }
    @media (max-width: 600px) {
      .hero-section h1 { font-size: 2rem; }
    }
    .hero-desc {
      font-size: 1.15rem;
      color: #3b4e53;
      max-width: 780px;
      margin: 0 auto 28px;
      line-height: 1.65;
    }

    /* Trust Stats Strip */
    .stats-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 22px;
      margin: 32px auto 0;
      box-shadow: 0 2px 10px rgba(14, 59, 67, 0.04);
      text-align: left;
    }
    .stat-item {
      display: flex;
      flex-direction: column;
      border-right: 1px solid #eeebe5;
      padding-right: 14px;
    }
    .stat-item:last-child { border-right: none; }
    .stat-val {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--primary);
      line-height: 1.2;
    }
    .stat-lbl {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-top: 4px;
    }

    /* Filter & Search Bar */
    .catalog-bar {
      margin: 40px 0 24px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
    .filter-chips {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .chip-btn {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 7px 14px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .chip-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .chip-btn.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
    }
    .search-input {
      padding: 8px 16px;
      border: 1px solid var(--border);
      border-radius: 20px;
      font-size: 0.88rem;
      width: 260px;
      background: var(--surface);
      outline: none;
    }
    .search-input:focus { border-color: var(--accent); }

    /* Spotlight Editor Reviews Cards */
    .spotlight-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 28px;
      margin-bottom: 48px;
    }
    @media (max-width: 820px) {
      .spotlight-grid { grid-template-columns: 1fr; }
    }

    .spotlight-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 26px;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 4px 14px rgba(14, 59, 67, 0.05);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .spotlight-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 22px rgba(14, 59, 67, 0.09);
      border-color: var(--accent);
    }
    .spotlight-badge {
      position: absolute;
      top: 18px;
      right: 18px;
      background: #eef7f4;
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 4px;
      border: 1px solid rgba(42, 127, 98, 0.25);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .spotlight-product-top {
      display: flex;
      gap: 18px;
      align-items: center;
      margin-bottom: 18px;
    }
    .spotlight-img-box {
      width: 110px;
      height: 120px;
      background: #fbf9f6;
      border-radius: 8px;
      border: 1px solid #ede8e1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
      flex-shrink: 0;
    }
    .spotlight-img-box img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .spotlight-info h2 {
      font-size: 1.3rem;
      color: var(--primary);
      line-height: 1.3;
      margin-bottom: 6px;
    }
    .rating-row {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.88rem;
    }
    .stars { color: #e28a00; letter-spacing: 1px; }
    .rating-score { font-weight: 700; color: var(--primary); }
    .rating-count { color: var(--text-muted); font-size: 0.8rem; }

    .spotlight-desc {
      font-size: 0.95rem;
      color: #3b4e53;
      margin-bottom: 16px;
      line-height: 1.6;
      flex-grow: 1;
    }

    .actives-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 20px;
    }
    .active-tag {
      background: #f0f7f4;
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid rgba(42, 127, 98, 0.15);
    }

    .card-action-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border);
      padding-top: 16px;
      margin-top: auto;
    }
    .target-skin {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 600;
    }
    .btn-review {
      background: var(--primary);
      color: #ffffff;
      text-decoration: none;
      padding: 9px 18px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.88rem;
      transition: background 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-review:hover { background: var(--accent); }

    /* Spotlight Card Social Sharing Toolbar */
    .card-share-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px dashed rgba(14, 59, 67, 0.15);
      padding-top: 11px;
      margin-top: 13px;
      gap: 10px;
    }
    .share-toolbar-label {
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      user-select: none;
    }
    .share-icon-group {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .share-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      color: #64748b;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      transition: all 0.18s ease;
      position: relative;
    }
    .share-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    .share-btn.share-x:hover {
      background: #000000;
      border-color: #000000;
      color: #ffffff;
    }
    .share-btn.share-fb:hover {
      background: #1877f2;
      border-color: #1877f2;
      color: #ffffff;
    }
    .share-btn.share-in:hover {
      background: #0a66c2;
      border-color: #0a66c2;
      color: #ffffff;
    }
    .share-btn.share-wa:hover {
      background: #25d366;
      border-color: #25d366;
      color: #ffffff;
    }
    .share-btn.share-copy:hover {
      background: #0f2c3a;
      border-color: #0f2c3a;
      color: #ffffff;
    }
    .share-btn.copied {
      background: #10b981 !important;
      border-color: #10b981 !important;
      color: #ffffff !important;
    }
    .copy-toast {
      position: absolute;
      bottom: calc(100% + 6px);
      right: 0;
      background: #0f2c3a;
      color: #ffffff;
      font-size: 0.72rem;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 0.2s, transform 0.2s;
      z-index: 20;
      box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    }
    .copy-toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* Clinical Categories Section - Pro & Clean */
    .section-header {
      margin: 48px 0 20px;
      text-align: center;
    }
    .section-header h2 {
      font-size: 1.8rem;
      color: var(--primary);
      margin-bottom: 8px;
    }
    .section-header p {
      color: var(--text-muted);
      font-size: 1rem;
      max-width: 650px;
      margin: 0 auto;
    }
    .clinical-kicker {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      margin-bottom: 8px;
    }

    .skin-conditions-section {
      margin-bottom: 56px;
    }
    .condition-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 22px;
      margin-top: 28px;
    }
    .condition-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    }
    .condition-card:hover {
      border-color: var(--accent);
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(14, 59, 67, 0.07);
    }
    .condition-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 20px;
      right: 20px;
      height: 3px;
      background: #e6e2db;
      border-radius: 0 0 3px 3px;
      transition: background 0.18s ease;
    }
    .condition-card:hover::before {
      background: var(--accent);
    }
    .condition-card-header {
      margin-bottom: 12px;
      padding-top: 4px;
    }
    .condition-badge {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #55757d;
      margin-bottom: 6px;
    }
    .condition-card-header h3 {
      font-size: 1.22rem;
      color: var(--primary-dark);
      font-weight: 700;
      line-height: 1.3;
    }
    .condition-desc {
      font-size: 0.9rem;
      color: #405156;
      line-height: 1.55;
      margin-bottom: 16px;
    }
    .condition-actives {
      background: #f7faf9;
      border: 1px solid #dbebe5;
      border-radius: 6px;
      padding: 10px 12px;
      margin-bottom: 16px;
      font-size: 0.82rem;
    }
    .actives-label {
      display: block;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 3px;
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .actives-val {
      color: #2a5e4d;
      font-weight: 500;
      line-height: 1.45;
      display: block;
    }
    .condition-tested-list {
      margin-bottom: 18px;
      flex-grow: 1;
    }
    .tested-heading {
      display: block;
      font-size: 0.76rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      margin-bottom: 8px;
    }
    .condition-tested-list ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .condition-tested-list li a {
      color: var(--primary);
      text-decoration: none;
      font-size: 0.86rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 10px;
      border-radius: 4px;
      background: #faf9f6;
      border: 1px solid #eee9e0;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .condition-tested-list li a:hover {
      background: #eef7f4;
      border-color: rgba(42, 127, 98, 0.3);
      color: var(--accent);
    }
    .rating-tiny {
      font-size: 0.75rem;
      font-weight: 700;
      color: #d97706;
      margin-left: 6px;
      white-space: nowrap;
    }
    .condition-card-footer {
      border-top: 1px solid var(--border);
      padding-top: 14px;
      margin-top: auto;
    }
    .btn-condition-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--accent);
      font-weight: 700;
      font-size: 0.86rem;
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .btn-condition-link:hover {
      color: var(--primary);
    }

    /* Testing Methodology Preview Box */
    .method-preview-card {
      background: linear-gradient(135deg, #0e3b43 0%, #175460 100%);
      color: #ffffff;
      border-radius: 12px;
      padding: 38px 40px;
      margin-bottom: 50px;
    }
    .method-preview-card h2 {
      font-size: 1.8rem;
      margin-bottom: 12px;
      color: #ffffff;
    }
    .method-preview-card p {
      font-size: 1.02rem;
      color: #d1e4e7;
      max-width: 760px;
      margin-bottom: 24px;
      line-height: 1.65;
    }
    .method-bullets {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 28px;
    }
    .method-bullet-item {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      padding: 16px;
    }
    .method-bullet-item h4 {
      font-size: 1rem;
      color: #ffffff;
      margin-bottom: 6px;
    }
    .method-bullet-item p {
      font-size: 0.85rem;
      color: #c0d8dc;
      margin-bottom: 0;
      line-height: 1.5;
    }
    .btn-method {
      display: inline-block;
      background: var(--accent);
      color: #ffffff;
      text-decoration: none;
      padding: 11px 24px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.92rem;
    }
    .btn-method:hover { background: #236c53; }

    /* Footer */
    footer {
      background: #132428;
      color: #a8bec3;
      padding: 46px 0 34px;
      font-size: 0.88rem;
      line-height: 1.6;
      border-top: 1px solid #233a3f;
      margin-top: 60px;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 32px;
      margin-bottom: 32px;
    }
    .footer-col h4 {
      color: #ffffff;
      font-size: 0.95rem;
      margin-bottom: 14px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .footer-col ul { list-style: none; }
    .footer-col li { margin-bottom: 8px; }
    .footer-col a { color: #a8bec3; text-decoration: none; transition: color 0.15s; }
    .footer-col a:hover { color: #ffffff; text-decoration: underline; }
    .footer-disclaimer {
      font-size: 0.8rem;
      color: #7b9499;
      border-top: 1px solid #223c42;
      padding-top: 22px;
    }

    /* Newsletter Signup (Dark Footer Match) */
    .footer-newsletter-wrap {
      background: #192c31;
      border: 1px solid #233a3f;
      border-radius: 12px;
      padding: 30px 32px;
      margin-bottom: 40px;
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 32px;
      align-items: center;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    }
    @media (max-width: 860px) {
      .footer-newsletter-wrap {
        grid-template-columns: 1fr;
        padding: 24px 20px;
        gap: 20px;
      }
    }
    .newsletter-kicker {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #5eead4;
      margin-bottom: 6px;
    }
    .newsletter-title {
      color: #ffffff;
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 0 6px 0;
      line-height: 1.3;
    }
    .newsletter-desc {
      color: #a8bec3;
      font-size: 0.88rem;
      margin: 0;
      line-height: 1.5;
    }
    .footer-newsletter-form {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .newsletter-input-group {
      display: flex;
      gap: 10px;
      align-items: stretch;
    }
    @media (max-width: 520px) {
      .newsletter-input-group {
        flex-direction: column;
      }
    }
    .newsletter-input {
      flex: 1;
      background: #0e1b1e;
      border: 1px solid #2a444a;
      color: #ffffff;
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .newsletter-input::placeholder {
      color: #6b848a;
    }
    .newsletter-input:focus {
      border-color: #2a7f62;
      box-shadow: 0 0 0 3px rgba(42, 127, 98, 0.25);
      background: #112226;
    }
    .newsletter-btn {
      background: #2a7f62;
      color: #ffffff;
      font-size: 0.9rem;
      font-weight: 600;
      padding: 12px 22px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .newsletter-btn:hover {
      background: #236c53;
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(42, 127, 98, 0.35);
    }
    .newsletter-btn:disabled {
      opacity: 0.75;
      cursor: not-allowed;
      transform: none;
    }
    .newsletter-feedback {
      font-size: 0.82rem;
      min-height: 1.2rem;
      transition: opacity 0.2s;
    }
    .newsletter-feedback.success {
      color: #4ade80;
      font-weight: 500;
    }
    .newsletter-feedback.error {
      color: #f87171;
      font-weight: 500;
    }

    /* Sunscreen Comparison Decision Section */
    .comparison-section {
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 40px 32px;
      margin: 50px 0 40px;
      box-shadow: 0 4px 20px rgba(15, 32, 39, 0.05);
    }
    .comparison-header {
      text-align: center;
      margin-bottom: 28px;
    }
    .comparison-badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--accent);
      background: #eef7f4;
      border: 1px solid rgba(42, 127, 98, 0.25);
      padding: 4px 12px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
    }
    .comparison-header h2 {
      font-size: 1.85rem;
      color: var(--primary);
      margin-bottom: 10px;
      line-height: 1.3;
    }
    .comparison-header p {
      color: var(--text-muted);
      font-size: 1rem;
      max-width: 740px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Quick 3-Way Decision Matrix Cards */
    .decision-matrix-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .decision-matrix-card {
      background: #fbfdfc;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      border-top: 4px solid var(--accent);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .decision-matrix-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(15, 32, 39, 0.06);
    }
    .decision-matrix-card.card-acne { border-top-color: #1e5c46; }
    .decision-matrix-card.card-scalp { border-top-color: #0f766e; }
    .decision-matrix-card.card-barrier { border-top-color: #1d4ed8; }

    .matrix-card-tag {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
    }
    .matrix-card-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--primary);
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .matrix-card-desc {
      font-size: 0.88rem;
      color: #3b5055;
      line-height: 1.5;
      margin: 0;
    }
    .matrix-card-link {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--accent);
      text-decoration: none;
      margin-top: 6px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .matrix-card-link:hover { text-decoration: underline; }

    /* Comparison Table Responsive Container */
    .table-scroll-hint {
      display: none;
      font-size: 0.78rem;
      color: var(--text-muted);
      text-align: right;
      margin-bottom: 8px;
      font-style: italic;
    }
    .table-responsive-box {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #ffffff;
    }
    .comparison-table {
      width: 100%;
      min-width: 820px;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.92rem;
    }
    .comparison-table th, .comparison-table td {
      padding: 16px 18px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
      line-height: 1.5;
    }
    .comparison-table th {
      background: #f4f8f6;
      color: var(--primary);
      font-weight: 700;
      font-size: 0.84rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }
    .comparison-table tr:last-child td {
      border-bottom: none;
    }
    .comparison-table .th-product { width: 230px; }
    .comparison-table .th-filters { width: 180px; }
    .comparison-table .th-actives { width: 220px; }
    .comparison-table .th-skin { width: 210px; }
    .comparison-table .th-finish { width: 170px; }
    .comparison-table .th-verdict { width: 240px; }

    .compare-product-flex {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }
    .compare-product-img {
      width: 58px;
      height: 64px;
      object-fit: contain;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 4px;
      flex-shrink: 0;
    }
    .compare-product-info h4 {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--primary);
      margin: 0 0 4px;
      line-height: 1.3;
    }
    .compare-badge-pill {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 4px;
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .pill-eltamd { background: #e8f5f0; color: #1e5c46; border: 1px solid #cce8dd; }
    .pill-bald { background: #e6f4f1; color: #0f766e; border: 1px solid #bce4dc; }
    .pill-lrp { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }

    .compare-rating-line {
      font-size: 0.8rem;
      color: #e28a00;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .compare-rating-line span {
      color: var(--text-muted);
      font-weight: 400;
      margin-left: 4px;
    }

    .table-tag {
      display: inline-block;
      font-size: 0.76rem;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 4px;
      margin: 2px 4px 3px 0;
      line-height: 1.35;
    }
    .tag-active {
      background: #f0f7f4;
      color: var(--accent);
      border: 1px solid rgba(42, 127, 98, 0.2);
    }
    .tag-filter {
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #cbd5e1;
    }
    .tag-skin {
      background: #fffbeb;
      color: #92400e;
      border: 1px solid #fde68a;
    }

    .table-cta-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--accent);
      font-weight: 700;
      font-size: 0.84rem;
      text-decoration: none;
      margin-top: 6px;
      transition: color 0.15s;
    }
    .table-cta-link:hover {
      color: var(--primary);
      text-decoration: underline;
    }
    .verdict-box {
      font-size: 0.86rem;
      line-height: 1.5;
      color: #2c3e44;
    }
    .verdict-box strong {
      color: var(--primary);
      display: block;
      margin-bottom: 2px;
    }
  </style>

  <!-- Global Responsive Fixes -->
  <style>
    .amazon-affiliate-button img { max-width: 320px; width: 100%; height: auto; display: block; margin: 0 auto; }
  </style>
  <style>
    @media (max-width: 768px) {
      /* Header & Nav Wrapping */
      .header-inner, .nav-container { flex-direction: column !important; justify-content: center !important; gap: 14px !important; padding: 15px !important; align-items: center !important; }
      .nav-links, nav ul { flex-wrap: wrap !important; justify-content: center !important; gap: 10px !important; padding: 0 !important; }
      
      /* Typography Scaling */
      h1 { font-size: 1.85rem !important; line-height: 1.25 !important; }
      h2 { font-size: 1.5rem !important; line-height: 1.3 !important; }
      h3 { font-size: 1.25rem !important; }
      p { font-size: 0.95rem !important; }
      
      /* Layout & Grids */
      .spotlight-grid, .related-grid, .footer-grid, .footer-container, .hero-spotlight { 
        grid-template-columns: 1fr !important; 
        display: grid !important; 
        gap: 24px !important;
      }
      .pros-cons-grid { grid-template-columns: 1fr !important; gap: 20px !important; }
      
      /* Spotlight & Related Cards */
      .spotlight-product-top { flex-direction: column !important; text-align: center !important; align-items: center !important; }
      .spotlight-img-box { margin: 0 auto !important; }
      .related-card { flex-direction: column !important; align-items: flex-start !important; }
      .related-card img.related-thumb { width: 100% !important; height: auto !important; max-width: 120px !important; margin-bottom: 12px !important; }
      .card-action-bar { flex-direction: column !important; gap: 12px !important; align-items: flex-start !important; }
      .card-action-bar a { width: 100% !important; text-align: center !important; }

      /* Hero Images & Affiliates */
      img, iframe, video { max-width: 100% !important; height: auto !important; }
      .amazon-affiliate-button img { max-width: 250px !important; margin: 0 auto !important; width: 100% !important; }
      .amazon-affiliate-button { display: flex !important; justify-content: center !important; width: 100% !important; }
      .hero-img-box { padding: 15px !important; margin-bottom: 20px !important; width: 100% !important; }
      
      /* Containers */
      .container { padding: 0 16px !important; }
      .main-wrapper { padding: 16px 16px 40px !important; }
      .page-wrap { padding: 16px !important; }
      .comparison-section { padding: 24px 14px !important; margin: 36px 0 28px !important; }
      .table-scroll-hint { display: block !important; }
      .comparison-header h2 { font-size: 1.45rem !important; }
      .decision-matrix-grid { grid-template-columns: 1fr !important; }
      
      /* Global Overflow Fix */
      body { overflow-x: hidden !important; width: 100% !important; }
    }
    
    @media (max-width: 480px) {
      h1 { font-size: 1.6rem !important; }
      h2 { font-size: 1.35rem !important; }
      .hero-details .rating-header, .rating-row { flex-direction: column !important; align-items: flex-start !important; gap: 6px !important; }
      .spotlight-product-top { text-align: left !important; align-items: flex-start !important; }
      .spotlight-img-box { margin: 0 !important; }
    }
  </style>
</head>

<body>

  <!-- Top Trust Bar -->
  <div class="top-bar">
    Independent Dermatological Testing • Evidence-Based Skincare Formulation Reviews • Medically Reviewed
  </div>

  <!-- Main Header -->
  <header>
    <div class="container header-inner">
      <a href="/" class="brand-logo" id="site-logo" aria-label="Clinical Derma Lab Homepage">
        <img src="/images/clinicaldermalab-logo.svg" alt="Clinical Derma Lab Certified Seal" width="220" height="38" style="height: 38px; width: auto; max-width: 220px; display: block;" fetchpriority="high" decoding="async" />
        <span class="badge-certified">Independent Research</span>
      </a>
      <nav id="main-navigation" aria-label="Main Navigation">
        <ul>
          <li><a href="/" class="nav-pill-active" aria-current="page">Home</a></li>
          <li><a href="/treatments">Treatments</a></li>
          <li><a href="/conditions">Conditions</a></li>
          <li><a href="/science-and-ingredients">Science &amp; Ingredients</a></li>
          <li><a href="/medical-review-board">Medical Board</a></li>
          <li><a href="/methodology.html">Methodology</a></li>
          <li><a href="/blog.html">Blog</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="container" id="main-content">

    <!-- Clinical Authority Bar (E-E-A-T Pillar 4) -->
    <aside class="clinical-authority-bar" aria-label="Medical Review Disclosure" style="margin-top: 18px; margin-bottom: 24px;">
      <div class="authority-bar-left">
        <div class="authority-avatar-badge" aria-hidden="true">AT</div>
        <div class="authority-details">
          <p class="authority-statement">
            Medically Reviewed by <a href="/medical-review-board">Dr. Aris Thorne, MD, FAAD</a> (Board-Certified Dermatologist &amp; Clinical Director)
          </p>
          <p class="authority-meta">
            Last Clinical Audit: October 2026 &bull; Evidence-Based Dermatological Protocol &bull; Zero Commercial Sponsorships
          </p>
        </div>
      </div>
      <div class="authority-bar-right">
        <button type="button" class="btn-verify-credentials" id="verify-credentials-btn" aria-haspopup="dialog" aria-controls="credentials-modal">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          Verify Medical Credentials
        </button>
      </div>
    
      <div class="ftc-authority-disclosure" style="font-size: 0.78rem; color: var(--text-muted); margin-top: 8px; padding-top: 6px; border-top: 1px dashed rgba(42, 127, 98, 0.2);">Reader-Supported Independent Lab: Zero paid brand placements. We may earn a commission from qualifying retail links.</div></aside>

    <!-- Flagship Homepage Hero -->
    <section class="hero-section">
      <div style="margin-bottom: 16px;">
        <a href="/elemis-dynamic-resurfacing-facial-pads-review.html" style="display: inline-flex; align-items: center; gap: 8px; background: #0e3b43; color: #ffffff; padding: 6px 16px; border-radius: 999px; text-decoration: none; font-size: 0.88rem; font-weight: 600; box-shadow: 0 2px 10px rgba(14,59,67,0.25); transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='none'">
          <span style="background: #2a7f62; color: #ffffff; padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px;">Latest Article</span>
