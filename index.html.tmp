  <!-- Interactive Filtering & Search Script -->
  <script>
    function filterCatalog(category, buttonEl) {
      var chips = document.querySelectorAll('.chip-btn');
      chips.forEach(function(c) { c.classList.remove('active'); });
      if (buttonEl) buttonEl.classList.add('active');

      var cards = document.querySelectorAll('.spotlight-card');
      cards.forEach(function(card) {
        var cardCat = card.getAttribute('data-category') || '';
        if (category === 'all' || cardCat.indexOf(category) !== -1) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function searchCatalog() {
      var query = document.getElementById('catalog-search').value.toLowerCase().trim();
      var cards = document.querySelectorAll('.spotlight-card');
      cards.forEach(function(card) {
        var title = (card.getAttribute('data-title') || '').toLowerCase();
        var text = card.innerText.toLowerCase();
        if (!query || title.indexOf(query) !== -1 || text.indexOf(query) !== -1) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function handleNewsletterSubmit(e) {
      e.preventDefault();
      var input = document.getElementById('newsletter-email');
      var feedback = document.getElementById('newsletter-feedback');
      var btn = document.getElementById('newsletter-btn');
      var email = input ? input.value.trim() : '';

      var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailRegex.test(email)) {
        if (feedback) {
          feedback.className = 'newsletter-feedback error';
          feedback.textContent = 'Please enter a valid email address.';
        }
        return;
      }

      try {
        var existing = JSON.parse(localStorage.getItem('cdl_subscribers') || '[]');
        if (existing.indexOf(email) === -1) {
          existing.push(email);
          localStorage.setItem('cdl_subscribers', JSON.stringify(existing));
        }
      } catch (err) {}

      if (btn) btn.disabled = true;
      if (input) input.disabled = true;
      if (feedback) {
        feedback.className = 'newsletter-feedback success';
        feedback.innerHTML = '&#10003; Subscribed! You will receive future independent clinical skincare review alerts.';
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      try {
        var existing = JSON.parse(localStorage.getItem('cdl_subscribers') || '[]');
        if (existing.length > 0) {
          var feedback = document.getElementById('newsletter-feedback');
          var input = document.getElementById('newsletter-email');
          var btn = document.getElementById('newsletter-btn');
          if (input) input.value = existing[existing.length - 1];
          if (feedback) {
            feedback.className = 'newsletter-feedback success';
            feedback.innerHTML = '&#10003; Active subscriber. You will receive new clinical update notifications.';
          }
        }
      } catch (e) {}
    });

    /* Social Sharing Handler */
    function shareClinicalReview(event, platform, relativeUrl, title) {
      if (event) event.stopPropagation();
      var fullUrl = window.location.origin + relativeUrl;
      var cleanTitle = (title || 'Clinical Dermatology Review').replace(/&amp;/g, '&');
      var shareText = cleanTitle + ' - Clinical Dermatology Review at ClinicalDermaLab';

      if (platform === 'copy') {
        var btn = event.currentTarget;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(fullUrl).then(function() {
            showCopyFeedback(btn);
          }).catch(function() {
            fallbackCopy(fullUrl, btn);
          });
        } else {
          fallbackCopy(fullUrl, btn);
        }
        return;
      }

      var shareUrl = '';
      if (platform === 'x') {
        shareUrl = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText) + '&url=' + encodeURIComponent(fullUrl);
      } else if (platform === 'facebook') {
        shareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(fullUrl);
      } else if (platform === 'linkedin') {
        shareUrl = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(fullUrl);
      } else if (platform === 'whatsapp') {
        shareUrl = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(shareText + ' ' + fullUrl);
      }

      if (shareUrl) {
        var w = 620, h = 480;
        var left = Math.max(0, (window.innerWidth / 2) - (w / 2) + (window.screenX || 0));
        var top = Math.max(0, (window.innerHeight / 2) - (h / 2) + (window.screenY || 0));
        window.open(shareUrl, 'share_' + platform, 'toolbar=no,location=no,directories=no,status=no,menubar=no,scrollbars=yes,resizable=yes,copyhistory=no,width=' + w + ',height=' + h + ',top=' + top + ',left=' + left);
      }
    }

    function showCopyFeedback(btn) {
      if (!btn) return;
      var originalHtml = btn.innerHTML;
      btn.classList.add('copied');
      btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

      var toast = document.createElement('div');
      toast.className = 'copy-toast show';
      toast.textContent = 'Link copied!';
      btn.appendChild(toast);

      setTimeout(function() {
        btn.classList.remove('copied');
        btn.innerHTML = originalHtml;
        if (toast.parentNode) toast.parentNode.removeChild(toast);
      }, 2000);
    }

    function fallbackCopy(text, btn) {
      var textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-999999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand('copy');
        showCopyFeedback(btn);
      } catch (err) {}
      document.body.removeChild(textArea);
    }
  </script>

  <!-- Verification Modal (Accessible Dialog) -->
  <div class="modal-overlay" id="credentials-modal" hidden style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-doctor-title">
    <div class="modal-card">
      <button type="button" class="modal-close-btn" id="close-credentials-modal" aria-label="Close credentials verification modal">&times;</button>
      <h2 id="modal-doctor-title" style="font-size: 1.35rem; color: var(--primary); margin-bottom: 8px;">Medical Credentials Verification</h2>
      <p style="font-size: 0.88rem; color: var(--accent); font-weight: 700; margin-bottom: 16px;">Dr. Aris Thorne, MD, FAAD</p>
      <div style="font-size: 0.88rem; line-height: 1.6; color: #334155; display: flex; flex-direction: column; gap: 10px;">
        <p><strong>Medical Specialty:</strong> Dermatology &amp; Cutaneous Surgery</p>
        <p><strong>Board Certification:</strong> American Board of Dermatology (ABD) &bull; Fellow, American Academy of Dermatology (FAAD)</p>
        <p><strong>Academic Appointment:</strong> Clinical Associate Professor of Cutaneous Medicine</p>
        <p><strong>Editorial Ethics:</strong> Neither Dr. Thorne nor Clinical Derma Lab accepts manufacturer compensation or sponsored reviews. All biometric tests are conducted independently.</p>
      </div>
      <div style="margin-top: 24px; text-align: right;">
        <a href="/medical-review-board" style="color: var(--accent); font-weight: 700; text-decoration: none; font-size: 0.88rem;">
          View Full Medical Review Board Profile &rarr;
        </a>
      </div>
    </div>
  </div>

  <script src="/js/seo-enhancer.js"></script>
</body>
</html>
