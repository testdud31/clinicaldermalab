<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f2c3a" />
      <stop offset="100%" stop-color="#1e4e5f" />
    </linearGradient>
    <linearGradient id="crossGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#10b981" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Rounded Squircle Badge -->
  <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#shieldGrad)" filter="url(#glow)"/>
  <rect x="3" y="3" width="58" height="58" rx="15" fill="none" stroke="#2a7f62" stroke-width="1.5" stroke-opacity="0.4"/>

  <!-- Clinical Shield Outline -->
  <path d="M32 10 C42 10, 48 13, 49 19 C49 33, 41 45, 32 52 C23 45, 15 33, 15 19 C16 13, 22 10, 32 10 Z" 
        fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>

  <!-- Medical Cross in Center -->
  <path d="M28 22 H36 V28 H42 V36 H36 V42 H28 V36 H22 V28 H28 Z" 
        fill="url(#crossGrad)"/>

  <!-- Cellular Science Dot Sparkle -->
  <circle cx="32" cy="18" r="2.2" fill="#a7f3d0" />
  <circle cx="44" cy="32" r="1.8" fill="#38bdf8" />
</svg>
